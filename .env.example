# Copy and supply private values, or run pnpm dev:env (never overwrites .env).
DATABASE_URL=postgresql://nuance:REPLACE_ME@127.0.0.1:5432/nuance
POSTGRES_USER=nuance
POSTGRES_PASSWORD=
POSTGRES_DB=nuance
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MINIO_ROOT_USER=nuance-local
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nuance-private
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Nuance <hello@nuance.local>
# Real provider: TLS on port 465, authentication, queue and delivery verification required.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
